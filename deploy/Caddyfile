# Caddy in front of the app (uvicorn listens on 127.0.0.1:8000 only).
#
# With a domain, Caddy gets an HTTPS certificate automatically:
#   dashboard.example.com {
#       ...same body as below...
#   }
#
# Without a domain, serve plain HTTP on the server's IP:
:80 {
	# Password-protect the dashboard. Make the hash with:
	#   caddy hash-password --plaintext 'your-password'
	basic_auth {
		dashboard REPLACE_WITH_HASH
	}
	reverse_proxy localhost:8000
}
