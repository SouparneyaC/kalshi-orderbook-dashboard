[Unit]
Description=Kalshi order book dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/tradedash
EnvironmentFile=/opt/tradedash/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tradedash/venv/bin/uvicorn app.server.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
