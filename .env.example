# Kalshi API credentials. Copy this file to .env and fill in your values.
KALSHI_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi_private_key.pem

# Optional settings (defaults shown)
# BOOK_COUNT=25          # order books to keep live
# TOP_LIST_BOOKS=6       # of those, reserved for the top rows of the table (default BOOK_COUNT // 4)
# PERSIST_TRADES=1       # 0 = do not save trades to DuckDB
